instance bottle_material < MDC_C003 {
  code: ANB112
  preferred_name.en: "bottle material"
  preferred_name.zh-TW: "壺身材質"
  definition.en: "material of the snuff bottle body"
  property_data_element_type: NON_DEPENDENT_P_DET
