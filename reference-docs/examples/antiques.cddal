  definition.en: "sheet format of the woodblock print"
  property_data_element_type: NON_DEPENDENT_P_DET
  definition_class: UkiyoEPrint
  data_type: ENUM_STRING_TYPE(print_format_enum)
}

# =============================================================================
# Configured subclasses — instance-of-instance used as a class
#
# A ceramics category × period selection yields a cataloguing class whose
# instances inherit Antique's core properties, Ceramics' kiln and glaze,
# and the conditional reign_mark.
# =============================================================================

instance MingBlueAndWhite < MDC_C002 {
  code: ANA150
  preferred_name.en: "Ming Blue-and-White Porcelain"
  preferred_name.zh-TW: "明青花"
  definition.en: "porcelain of the Ming dynasty decorated in underglaze cobalt blue"
  superclass: Ceramics
  class_type: ITEM_CLASS
  sub_class_selection: { Ming }
}

instance GoryeoCeladon < MDC_C002 {
  code: ANA151
  preferred_name.en: "Goryeo Celadon"
  preferred_name.ko: "고려청자"
  definition.en: "celadon-glazed stoneware of the Goryeo dynasty"
  superclass: Ceramics
  class_type: ITEM_CLASS
  sub_class_selection: { Goryeo }
}

# =============================================================================
# Registered individuals — well-known museum objects (leaf entities)
#
# Each is a concrete object with a native-language name, an English
# cataloguing name, and property values, classified through the power-type
# chain: Antique ← AntiqueCategory member ← configured subclass.
# =============================================================================

instance MaoGongDing < MDC_C002 {
  code: ANI001
  preferred_name.zh-TW: "毛公鼎"
  preferred_name.en: "Mao Gong Ding"
  short_name.en: "MaoGongDing"
  definition.en: "Western Zhou bronze tripod food vessel bearing one of the longest known Chinese bronze inscriptions, National Palace Museum, Taipei"
  superclass: Bronze
  class_type: ITEM_CLASS
  category: Bronze
  culture: China
  period: Zhou
  height: 53.8
  diameter: 47.9
  vessel_form: Ding
  inscription_characters: 497
  condition_grade: Excellent
}

instance JadeiteCabbage < MDC_C002 {
  code: ANI002
  preferred_name.zh-TW: "翠玉白菜"
